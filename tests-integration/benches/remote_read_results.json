  "notes": [
    "Exploratory results, not production/release performance.",
    "Final reviewed code; compilation and regression tests completed before this run.",
    "Three trials per case, a fresh standalone process for each trial, alternating format order. OS file cache was not cleared.",
    "Process CPU is user+system time; RSS sampled every 10 ms. Process startup occurs before the measurement.",
    "Only scalar data measured. Histograms currently use one sample per chunk.",
    "Response encoding buffers are bounded by batches/slices and the 1 MiB frame limit; total query memory includes sorting."
  ],
  "config": "enable_telemetry = false\n[http]\naddr = \"127.0.0.1:14000\"\ntimeout = \"600s\"\n[grpc]\nbind_addr = \"127.0.0.1:14001\"\n[mysql]\nenable = false\n[postgres]\nenable = false\n[runtime]\nglobal_rt_size = 4\ncompact_rt_size = 2\n[query]\nparallelism = 4\nmemory_pool_size = \"256MB\"\n[storage]\ndata_home = \"/tmp/greptime-chunk-benchmark/data\"\n[wal]\nprovider = \"raft_engine\"\ndir = \"/tmp/greptime-chunk-benchmark/wal\"\n[logging]\nlevel = \"warn\"\ndir = \"/tmp/greptime-chunk-benchmark/logs\"\n",
  "setup": {
    "cases": [
      {
        "series": 10,
        "rows": 1000000
      },
      {
        "series": 10000,
        "rows": 1000000
      },
      {
        "series": 10,
        "rows": 3000000
      }
    ],
    "create_sql": "CREATE TABLE rr_bench_{series}_{rows} (host STRING, job STRING, greptime_timestamp TIMESTAMP(3), greptime_value DOUBLE, TIME INDEX(greptime_timestamp), PRIMARY KEY(host,job))",
    "insert_sql": "INSERT INTO rr_bench_{series}_{rows} SELECT CAST((number+{start}) % {series} AS STRING), 'east', CAST(CAST(((number+{start}) / {series}) AS BIGINT) * 1000 AS TIMESTAMP), CAST((number+{start}) % 1000 AS DOUBLE)*0.001 FROM numbers LIMIT 250000",
    "insert_loop": "start in range(0, rows, 250000), on a new empty table; ADMIN FLUSH_TABLE after inserts",
    "measure": "Restart the server for every trial, wait for /health then 1 second; python3 tests-integration/benches/remote_read.py --pid PID --table TABLE --end-ms 1000000000 --mode samples|streamed --repeats 1"
  },
